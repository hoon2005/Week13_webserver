#!/bin/sh
# 끝나지 않는 CGI입니다 (테스트용). 아무것도 출력하지 않고 30초 동안 멈춰 있습니다.
#   M4-3: 실행 중에 서버를 재시작하거나 다른 연결을 닫아, CGI가 리스닝 소켓이나
#         다른 손님 소켓을 물고 있지 않은지 확인합니다 (fd 상속 차단).
#   M5-3: 10초 시간 제한에 걸려 504가 나오는지 확인합니다.
# 서버가 CGI에 PATH를 넘기지 않으므로 sleep은 절대 경로로 부릅니다.
# exec: sh 프로세스를 sleep으로 바꿔, 프로세스 하나만 남게 합니다.
exec /bin/sleep 30
