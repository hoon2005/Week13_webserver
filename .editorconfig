# 에디터가 저장할 때 맞추는 기본값입니다. C 파일의 모양은 .clang-format이 정합니다.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Markdown은 줄 끝 공백 두 개가 줄바꿈 뜻이 있어 지우지 않습니다.
trim_trailing_whitespace = false
